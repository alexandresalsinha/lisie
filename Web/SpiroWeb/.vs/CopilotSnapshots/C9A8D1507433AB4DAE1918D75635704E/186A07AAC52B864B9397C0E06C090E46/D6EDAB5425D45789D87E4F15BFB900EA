        private class StoreMetadataResult
        {
            public List<LisieStores.Extensibility.ProductSearchResult> StoreMetadata { get; set; }
            public string FoundBarcode { get; set; }
            public Products ExistingProduct { get; set; }
        }

        private static async Task<StoreMetadataResult> FetchStoreMetadataAsync(ProductItemCreate product, SpiroStockManagementEntities db)
        {
            var result = new StoreMetadataResult
            {
                StoreMetadata = new List<LisieStores.Extensibility.ProductSearchResult>(),
                FoundBarcode = null,
                ExistingProduct = null
            };

            foreach (var storeMetadata in product.SelectedResults)
            {
                var searchResult = await GetProductSearchResultAsync(storeMetadata);
                if (searchResult == null) continue;

                int existingId = CheckIfProductExistsInStore(searchResult.StoreId, searchResult.OnlineProductId, searchResult.Url);
                if (existingId != -1)
                {
                    result.ExistingProduct = db.Products.FirstOrDefault(c => c.Id == existingId);
                    return result;
                }

                result.StoreMetadata.Add(searchResult);

                if (string.IsNullOrEmpty(result.FoundBarcode) && !string.IsNullOrEmpty(searchResult.Barcode))
                {
                    result.FoundBarcode = searchResult.Barcode;
                }
            }

            return result;
        }

        private static async Task<LisieStores.Extensibility.ProductSearchResult> GetProductSearchResultAsync(
            LisieStores.Extensibility.ProductSearchResult storeMetadata)
        {
            var fetcher = Helpers.Extensibility.GetStoreFetcher(storeMetadata.StoreId);

            if (!string.IsNullOrEmpty(storeMetadata.Url))
            {
                return await fetcher.GetProductMetadata(storeMetadata.Url);
            }
            if (!string.IsNullOrEmpty(storeMetadata.OnlineProductId))
            {
                return await fetcher.GetProductMetadataById(storeMetadata.OnlineProductId);
            }
            return null;
        }

