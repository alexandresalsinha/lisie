        private static async Task<int> CreateNewProductWithStoresAsync(
            LisieStores.Extensibility.ProductSearchResult firstResult,
     string barcode,
            List<LisieStores.Extensibility.ProductSearchResult> storeMetadata,
    ProductItemCreate product)
        {
            var newProduct = GetProductOfSearchResult(firstResult);
            newProduct.IsTemp = true;
            newProduct.Barcode = barcode;
            newProduct.CreatedByUserId = product.UserId;

            int newProductId = AddNewProduct(newProduct);
            if (newProductId == -1)
            {
                return -10;
            }

            foreach (var result in storeMetadata.Where(r => r != null))
            {
                CreateOrUpdateStoreProductNew(result, newProductId, product.UserId, result.StoreId);
            }

            if (product.Lists == null || product.Lists.Count == 0)
            {
                return newProductId;
            }

            int userProductId = -1;
            foreach (string list in product.Lists)
            {
                userProductId = UserListsManager.AddProductToList(newProductId, newProduct.Name, list, 1, null, true, product.UserId);
            }
            return userProductId;
        }

        static async public Task<int> CreateV3(ProductItemCreate product)
        {
            using (SpiroStockManagementEntities db = new SpiroStockManagementEntities())
            {
                try
                {
                    // Check if product with barcode already exists
                    if (!string.IsNullOrEmpty(product.Barcode))
                    {
                        var existingProduct = GetByBarcodeV2(product.Barcode, product.UserId);
                        if (existingProduct != null)
                        {
                            return AddToListsOrReturnProductId(existingProduct, product.Lists, product.UserId);
                        }
                    }

                    // Check if product exists in stores by URL/OnlineProductId
                    int existingProductId = CheckIfProductExistsInStores(product.SelectedResults);
                    if (existingProductId != -1)
                    {
                        var existingProduct = db.Products.FirstOrDefault(c => c.Id == existingProductId);
                        return AddToListsOrReturnProductId(existingProduct, product.Lists, product.UserId);
                    }

                    // Fetch metadata from all selected stores
                    var metadataResult = await FetchStoreMetadataAsync(product, db);
                    if (metadataResult.ExistingProduct != null)
                    {
                        return AddToListsOrReturnProductId(metadataResult.ExistingProduct, product.Lists, product.UserId);
                    }

                    if (metadataResult.StoreMetadata.Count == 0)
                    {
                        return -9;
                    }

                    // Get the first valid search result for product creation
                    var firstResult = GetFirstValidSearchResult(metadataResult.StoreMetadata, product.FirstAddedProductFromStoreId);
                    if (firstResult == null)
                    {
                        return -9;
                    }

                    // Determine final barcode
                    string finalBarcode = DetermineFinalBarcode(product.Barcode, firstResult, metadataResult.FoundBarcode);

                    // Final check for existing product with barcode
                    if (!string.IsNullOrEmpty(finalBarcode))
                    {
                        var existingProduct = GetByBarcodeV2(finalBarcode, product.UserId);
                        if (existingProduct != null)
                        {
                            return HandleExistingProductWithStores(existingProduct, metadataResult.StoreMetadata, product);
                        }
                    }

                    // Check if barcode already exists in database
                    var productWithBarcode = db.Products.FirstOrDefault(c => c.Barcode == finalBarcode);
                    if (productWithBarcode != null)
                    {
                        return HandleExistingProductWithStores(productWithBarcode, metadataResult.StoreMetadata, product);
                    }

                    // Create new product
                    return await CreateNewProductWithStoresAsync(firstResult, finalBarcode, metadataResult.StoreMetadata, product);
                }
                catch (Exception ex)
                {
                    Logger.Debug(ex.InnerException?.Message ?? ex.Message);
                    return -9;
                }
            }
        }

