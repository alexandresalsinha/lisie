@model IEnumerable<ClassLibrary1.UserProductsList>
@using PagedList.Mvc;
@using PagedList;
@{
    ViewBag.Title = "Index";
    string sortByQueryString = (!string.IsNullOrEmpty(Request.QueryString["orderBy"]) ? Request.QueryString["orderBy"] : string.Empty);
    string pageQueryString = (!string.IsNullOrEmpty(Request.QueryString["page"]) ? Request.QueryString["page"] : string.Empty);
    string searchQueryString = (!string.IsNullOrEmpty(Request.QueryString["searchQuery"]) ? Request.QueryString["searchQuery"] : string.Empty);
}

<h2>Index</h2>

<p>
</p>


<table class="table">
    <tr>
        <th style="text-align: center;">

        </th>
        <th style="text-align: center;">
            Barcode
        </th>
        <th style="text-align: center;">
            <a href="@Url.Action("Index", "Products", new { page = 1, orderBy = "name", searchQuery = searchQueryString })">
                Name
            </a>
            @*<span class="glyphicons glyphicons-sorting"></span>*@
        </th>
        <th style="text-align: center;">
            Brand
        </th>
        <th style="text-align: center;">
            Category
        </th>
        <th style="text-align: center;">
            Weight
        </th>
        @*<th style="text-align: center;">
            @Html.DisplayNameFor(model => model.Price)
        </th>
        <th style="text-align: center;">
            Weight / Price
        </th>*@
        <th style="text-align: center;">
            List
        </th>
        <th style="text-align: center;">
            On UserId list
        </th>
        <th style="text-align: center;">
            <a href="@Url.Action("Index", "Products", new { page = 1, orderBy = "InsertDate", searchQuery = searchQueryString })">
                Added at date
            </a>
        </th>
        <th style="text-align: center;">
            Is Temp
        </th>
        <th></th>
    </tr>

    @foreach (var item in ViewBag.OnePageOfProducts)
    {
        <tr>
            <td>
                <a href="@Url.Action("Details", "Products", new { id = item.ProductId })"><img style="width:140px" src="~/Handlers/GetProductImage.ashx?productId=@item.ProductId" /></a>
            </td>

            <td style="text-align: center; vertical-align: middle;">
                @item.Products.Barcode
            </td>
            <td style="text-align: center; vertical-align: middle;">
                <a href="@Url.Action("Details", "Products", new { id = item.ProductId })">@item.Products.Name</a>
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @item.Products.Brand
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @item.Products.CategoryString
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @item.Products.Weight
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @(item.ListName.ToLower() == "in" ? "shopping list" : item.ListName) 
            </td>
            <td style="text-align: center; vertical-align: middle;">
                <a href="@Url.Action("Details", "Users", new { id = item.UserId })">@item.UserId</a>
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @item.LastAddedDate.ToString("dd-MM-yyyy")
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @(item.Products.IsTemp != null ? item.Products.IsTemp : "NULL")
            </td>
            <td style="text-align: center; vertical-align: middle; display: table-cell;">
                <a href="@Url.Action("Edit", "Products", new { id = item.Products.Id, orderBy = sortByQueryString })"><span class="glyphicon glyphicon-edit" style="font-size: 1.4em;" title="Edit"></span></a>
                <a href="@Url.Action("Delete", "Products", new { id = item.Products.Id, orderBy = sortByQueryString })"><span class="glyphicon glyphicon-remove" style="font-size: 1.4em;" title="Delete"></span></a>
            </td>
        </tr>
    }

</table>
@Html.PagedListPager((IPagedList)ViewBag.OnePageOfProducts, page => Url.Action("All", new { page, orderBy = sortByQueryString, searchQuery = searchQueryString}))
