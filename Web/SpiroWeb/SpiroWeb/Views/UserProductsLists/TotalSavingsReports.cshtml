@model IEnumerable<ClassLibrary1.UserTotalSavings>

@{
    ViewBag.Title = "User Total Savings";

    var _stores = new List<ClassLibrary1.Stores>();
    List<Tuple<string, List<ClassLibrary1.UserTotalSavings>>> _data = new List<Tuple<string, List<ClassLibrary1.UserTotalSavings>>>();
    using (ClassLibrary1.SpiroStockManagementEntities db = new ClassLibrary1.SpiroStockManagementEntities())
    {
        _stores = db.Stores.ToList();

        var _groupedBy = Model.GroupBy(c => c.StoreIds).ToList();

        foreach (var item in _groupedBy)
        {
            Tuple<string, List<ClassLibrary1.UserTotalSavings>> _item = new Tuple<string, List<ClassLibrary1.UserTotalSavings>>(item.Key, Model.Where(c => c.StoreIds == item.Key).OrderBy(c => c.CreateDate).ToList());
            _data.Add(_item);
            //item.Key
        }
        //var _groupByDistinct = _groupedBy.DistinctB("StoreIds");
        var _test = "asdas";
    }

}

