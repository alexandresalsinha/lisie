@model IEnumerable<ClassLibrary1.Interactions>

@{
    ViewBag.Title = "Interactions";
}

@*<div style="padding:25px;display: inline-block;">
    <h3 style="float:left">Updates count:</h3>
    <h3 id="newProducStoreUpdates" style="float:left;padding-left:5px"></h3>
    <h3 style="float:left;padding-left:40px">Started at:</h3>
    <h3 style="color:green;float:left;padding-left:5px">@DateTime.Now.ToString()</h3>
</div>
<div style="padding:25px;display: inline-block;">
    <h3 style="float:left">Fails count:</h3>
    <h3 id="newProductStoreUpdatesFailed" style="float:left;padding-left:5px"></h3>
</div>*@

<table class="table table-responsive" id="InteractionsTable">
    <tr>
        <th style="text-align: center;">
            Id
        </th>
        <th style="text-align: center;">
            UserId
        </th>
        <th style="text-align: center;">
            Name
        </th>
        @*<th style="text-align: center;">
            Extra
        </th>*@
        <th style="text-align: center;">
            Create Date
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {

        <tr>
            <td style="text-align: center; vertical-align: middle;">
                    @item.Id
            </td>
            <td style="text-align: center; vertical-align: middle;">
                <a href="/users/details/@item.UserId" target="_blank">
                    @item.UserId
                </a>
                
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @item.Name
            </td>
            @*<td style="text-align: center; vertical-align: middle;">
                @item.Extra
            </td>*@
            <td style="text-align: center; vertical-align: middle;">
                @item.CreateDate.ToString("dd-MM-yyyy hh:mm")
            </td>
        </tr>

    }

</table>

@section scripts {
    <script src="~/Scripts/jquery.color-2.1.2.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.2.0.js"></script>
    <script src="../signalr/hubs"></script>
    <script src="~/SignalR.Sample/SignalR.Interactions.js"></script>
}
