@model IEnumerable<ClassLibrary1.Statistics>

@{
    ViewBag.Title = "Total Interactions";
}

<table class="table" style="margin-top:50px; margin-bottom:50px; text-align:center">
    <tr>
        <th style="vertical-align: middle; text-align:center" style="vertical-align: middle; text-align:center">
            Users
        </th>
        <th style="vertical-align: middle; text-align:center" style="vertical-align: middle; text-align:center">
            Montlhy Active Useres
        </th>
        <th style="vertical-align: middle; text-align:center" style="vertical-align: middle; text-align:center">
            Products
        </th>
        <th style="vertical-align: middle; text-align:center">
            Interactions
        </th>
        <th style="vertical-align: middle; text-align:center">
            Lista de compras
        </th>
        <th style="vertical-align: middle; text-align:center">
            Despensa
        </th>
        <th style="vertical-align: middle; text-align:center">
            Consumidos
        </th>
        <th style="vertical-align: middle; text-align:center">
            Home - Lidos
        </th>
        <th style="vertical-align: middle; text-align:center">
            Home - Consumidos
        </th>
        <th style="vertical-align: middle; text-align:center">
            Date
        </th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.Users)
            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.UsersMonthlyActive)
            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.Products)
            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.Interactions)
            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.ProductsAddedToShoppingList)
            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.ProductsAddedToInventory)

            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.ProductsAddedToConsumed)
            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.LHBarcodesScanned)
            </td>
            <td style="vertical-align: middle;">
                @Html.DisplayFor(modelModel => item.LHProductsAddedToConsumed)
            </td>
            <td style="vertical-align: middle;">
                @item.InsertDate.ToString("dd-MM-yyyy HH:MM")
            </td>
        </tr>
    }
</table>
