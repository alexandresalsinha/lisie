@helper GetProductsMatchingText()
{
    LisieStores.Extensibility.ProductSearchResult _selectedProductResult = ViewBag.SelectedProduct as LisieStores.Extensibility.ProductSearchResult;
    //string _strippedNameOriginal = _selectedProductResult.Name.ToLower().Replace("  ", " ").Trim(' ').Replace(_selectedProductResult.Brand.ToLower(), "").Replace("  ", " ").Trim(' ').Replace(_selectedProductResult.Weight.ToLower(), "").Replace("  ", " ").Trim(' ');


    string _strippedNameOriginal = _selectedProductResult.Name.ToLower().Replace("  ", " ").Trim(' ');
    _strippedNameOriginal = (!string.IsNullOrEmpty(_selectedProductResult.Brand)) ? _strippedNameOriginal.Replace(_selectedProductResult.Brand.ToLower(), "").Replace("  ", " ").Trim(' ') : string.Empty;
    _strippedNameOriginal = (!string.IsNullOrEmpty(_selectedProductResult.Weight)) ? _strippedNameOriginal.Replace(_selectedProductResult.Weight.ToLower(), "").Replace("  ", " ").Trim(' ') : string.Empty;

    string stringTogetherOriginal = _strippedNameOriginal + " " + _selectedProductResult.Brand.ToLower() + " " + _selectedProductResult.Weight.ToLower();
    stringTogetherOriginal = stringTogetherOriginal.Trim(' ');

    @: @stringTogetherOriginal
}
