    <div style="float:left; width:70%">
        <div id="container">
            <a style="width:100%" id="@market.StoreId" href="#@market.StoreId" onclick="showStore(@market.StoreId)"> <div id="middle" style="background:@market.StoreColor">@market.StoreName</div></a>
        </div>

        <table id="(@market.StoreId)_SearchResults" class="table table-responsive">
            <tr>
                <th style="text-align: center;">

                </th>
                <th style="text-align: center;">

                </th>
                <th style="text-align: center;">
                    Sort Weight
                </th>
