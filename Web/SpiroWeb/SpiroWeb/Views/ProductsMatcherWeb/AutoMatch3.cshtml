<div id="product_div" style="float:left; width:30% ;position: fixed; top: 200px;">
    @*<h4>Products</h4>
        <hr />*@
    <dl class="dl-horizontal">
        <dt>
            @*@Html.DisplayNameFor(model => model.Picture)*@
        </dt>

        <dd>
            <img style="width:100%" src="@_selectedProductResult.ImageUrl" />
        </dd>

        <dt>
            Name
        </dt>

        <dd>
            @Html.DisplayFor(model => _selectedProductResult.Name)
        </dd>

        <dt>
            Brand
        </dt>
        <dd>
            @Html.DisplayFor(model => _selectedProductResult.Brand)
        </dd>

        <dt>
            Weight
        </dt>
        <dd>
            @Html.DisplayFor(model => _selectedProductResult.Weight)
        </dd>

        <dt>
            Price
        </dt>
        <dd>
            @Html.DisplayFor(model => _selectedProductResult.Price)

            @foreach (var _market in Markets)
            {
                var _currentStoreProduct = _storeProducts.Where(c => c.StoreId == _market.StoreId).FirstOrDefault();
                if (_currentStoreProduct != null)
                {
                    <a target="_blank" href="@(_market.StoreUrl + _currentStoreProduct.Url)">@_market.StoreName - @Math.Round(_currentStoreProduct.Price.Value, 2)</a>
                    <a href="#" onclick="scrollToo(@_market.StoreId)"><span class="glyphicon glyphicon-edit" style="font-size: 1.4em;" title="Go to"></span></a><br />
                }
                else
                {
                    <a href="#" onclick="scrollToo(@_market.StoreId)">@_market.StoreName</a>
                    <a href="#" onclick="scrollToo(@_market.StoreId)"><span class="glyphicon glyphicon-edit" style="font-size: 1.4em;" title="Go to"></span></a><br />
                }
            }
        </dd>

        <dt>
            Weight / Price
            @*@Html.DisplayNameFor(model => model.VariableWeightPrice)*@
        </dt>

        <dd>
            @Html.DisplayFor(model => _selectedProductResult.PriceWeight)
        </dd>

        <dt>
            @*@Html.DisplayNameFor(model => model.CategoryString)*@
            Category
        </dt>

        <dd>
            @Html.DisplayFor(model => _selectedProductResult.Category)
        </dd>

        @*<dt>
            @Html.DisplayNameFor(model => model.CategoryString)
            Matching Text
        </dt>*@

        @*<dd>
            @GetProductsMatchingText()
        </dd>*@
    </dl>
</div>
