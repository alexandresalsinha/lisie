                    Name
                </th>
                <th style="text-align: center;">
                    Brand
                </th>
                <th style="text-align: center;">
                    Weight
                </th>
                <th style="text-align: center;">
                    Price
                </th>
                <th style="text-align: center;">
                    Weight / Price
                </th>
                <th> Text A1 %</th>
                <th> Text Total Tx</th>
                <th> Text A2 % </th>
                <th> Text A3 (Together) % </th>
                <th> Tx ALL AVG %</th>
                <th> Tx ALL PLUS</th>
                <th> Text Together Tx</th>
                <th> ImageA1 %</th>
                <th> ImageA2 %</th>
                <th> Images Together +</th>
                <th> ImageA1 + Text(x12) %</th>
                <th> <b>Image Together + Tx % + Tx Together %</b></th>
                <th> Last 2 avg</th>
                <th> Tx % + Tx Together % + Image + Text % + Images Together </th>
                <th> ImageA1 + Text(x12) ++ Last 2 Avg ++ Before , AVG </th>
            </tr>

            @foreach (var item in Model.Where(c => c.StoreId == market.StoreId).Take(4))
            {
                var imgSrc = string.Empty;
                if (item.ImageUrl != null)
                {
                    imgSrc = item.ImageUrl;
                }

            <tr>
                <td style="text-align: center; vertical-align: middle; display: table-cell;">
                    <a href="@Url.Action("Match", "ProductsMatcherWeb", new { productId =_selectedProductResult.OnlineProductId, storeProductUrl = item.Url , storeId= item.StoreId})"><span class="glyphicon glyphicon-edit" style="font-size: 1.4em;" title="Match"></span></a>
                </td>
                <td>
                    @*@Html.DisplayFor(modelItem => item.Picture)*@
                    @*<a href="@Url.Action("Select", "ProductsMatcher", new { currentIndex })"><img style="width:140px" src="@imgSrc" /></a>*@
                    <a href="@item.ViewableUrl"><img style="width:140px" src="@imgSrc" /></a>
                </td>
                <td style="text-align: center; vertical-align: middle;">
                    @item.SortedWeight
                </td>
                <td style="text-align: center; vertical-align: middle;">
                    @item.Name
                </td>
                <td style="text-align: center; vertical-align: middle;">
                    @item.Brand
                </td>
                <td style="text-align: center; vertical-align: middle;">
                    @item.Weight
                </td>
                <td style="text-align: center; vertical-align: middle;">
                    @item.Price€
                </td>
                <td style="text-align: center; vertical-align: middle;">
                    @item.PriceWeight
                </td>
                <td> @Math.Round(item.EqualsPercentage, 2).ToString() </td>
                <td> @item.EqualsPercentageText</td>
                <td>@Math.Round(item.TextEqualsPercentage, 2).ToString()</td>
                <td>@Math.Round(item.TextTogetherEqualsPercentage, 2).ToString()</td>
                <td>@Math.Round(((item.TextTogetherEqualsPercentage + item.TextEqualsPercentage) / 2), 2).ToString()</td>
                <td>@Math.Round(item.TxAllTogetherPlus, 2)</td>
                <td>@item.TextTogetherEqualsPercentageText</td>
                <td>
                    @item.ImageEqualsPercentage %
                </td>
                <td>
                    @Math.Round(item.ImageEqualsPercentage2) %
                </td>
                <td>
                    @Math.Round(item.ImagesTogetherPercentage) %
                </td>
                <td>@Math.Round(item.ImageTextEqualsPercentage, 2).ToString()</td>
                <td>@Math.Round(item.ImageTogetherTextEqualsPercentage, 2).ToString()</td>

                <td>@Math.Round(((item.ImageTextEqualsPercentage + item.ImageTogetherTextEqualsPercentage * 2) / 2), 2).ToString()</td>

                @*@{
            var _avgText = (item.TextTogetherEqualsPercentage + item.TextEqualsPercentage) / 2;
            var _avgImg = item.ImagesTogetherPercentage / 2;
            _avgImg *= 2;
            //_avgImg = _avgImg + 1000;
            var _avgTextPlusImg = (item.ImageTextEqualsPercentage * 100) / 650;
            //var _avgTextPlusImg = item.ImageTextEqualsPercentage;
            var _finalWeight = (_avgImg + _avgText + _avgTextPlusImg) / 3;
        }*@
                @*<td>@Math.Round(_finalWeight, 2).ToString()</td>*@
                <td>@Math.Round(item.FinalWeight, 2).ToString()</td>
                <td>@Math.Round(item.FinalWeight2, 2).ToString()</td>
            </tr>
            }
        </table>
    </div>


    currentIndex++;
}



@helper GetMarketName(int storeId)
{
    List<LisieStores.Extensibility.Market> _markets = SpiroWeb.Helpers.Extensibility.GetStoreFetchers();

    var _market = _markets.Where(c => c.StoreId == storeId).FirstOrDefault();
    if (_market != null)
    {
        @: @_market.StoreName
    }
    else
    {
        @: @string.Empty
    }
}

