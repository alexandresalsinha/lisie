@model IEnumerable<SpiroWeb.Objects.ProductSearchMatchResult>

@{
    ViewBag.Title = "Products Matcher";

    string searchQueryString = (!string.IsNullOrEmpty(Request.QueryString["searchQuery"]) ? Request.QueryString["searchQuery"] : string.Empty);

    //LisieStores.Extensibility.ProductSearchResult _selectedProductResult = Session["selectedProduct"] as LisieStores.Extensibility.ProductSearchResult;
    LisieStores.Extensibility.ProductSearchResult _selectedProductResult = ViewBag.SelectedProduct as LisieStores.Extensibility.ProductSearchResult;

    List<ClassLibrary1.StoreProducts> _storeProducts = null;

    List<LisieStores.Extensibility.Market> Markets = SpiroWeb.Helpers.Extensibility.GetStoreFetchers();

    Markets = Markets.OrderBy(c => c.StoreId).ToList();

    using (ClassLibrary1.SpiroStockManagementEntities db = new ClassLibrary1.SpiroStockManagementEntities())
    {
        int _productId = int.Parse(_selectedProductResult.OnlineProductId);
        _storeProducts = db.StoreProducts.Include("Stores").Where(c => c.ProductId == _productId).ToList();
    }
    //var _storeProducts = Model.StoreProducts.Where(c => c.StoreId == 1).FirstOrDefault();

}
