@helper GetSimilarity(SpiroWeb.Objects.ProductSearchResult productSearchResult)
{
    if (Session["selectedProduct"] != null)
    {
        @*string similarityPercentage = SpiroWeb.Managers.ProductsMatcherManager.GetProductsSimilarity(Session["selectedProduct"] as SpiroWeb.Objects.ProductSearchResult, productSearchResult);

            @: @similarityPercentage*@
    }

    @: 0
}

