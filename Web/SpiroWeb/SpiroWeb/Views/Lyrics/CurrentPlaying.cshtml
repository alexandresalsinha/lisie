@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Artist - @ViewBag.Track Lyrics</title>
    <style>
        * {
            font-size: 30pt;
            font-family: Arial;
        }

        body {
            background-color: black;
            color: white;
        }

        /*.column {
            float: left;
            width: 33%;
        }*/

        .row {
            height: 100%;
            column-count: 4;
        }
    </style>

</head>
<body>
    <div class='row'>
        @Html.Raw(ViewBag.LyricsText)
    </div>


    <script src="~/Scripts/jquery-1.8.2.js"></script>
    <script src="~/Scripts/jquery.signalR-2.2.0.js"></script>
    <script src="../signalr/hubs"></script>
    <script src="~/SignalR.Sample/SignalR.Lyrics.js"></script>
</body>
</html>
