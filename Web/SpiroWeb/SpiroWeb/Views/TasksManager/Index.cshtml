@Html.Partial("~/Views/TasksManager/_Work.cshtml")
@Html.Partial("~/Views/TasksManager/_Social.cshtml")
@Html.Partial("~/Views/TasksManager/_Personal.cshtml")

<div id="dialog-form" title="Create New Task" style="display: none">
    <form>
        <fieldset>
            <label for="name">Description</label><br />
            <input type="text" name="name" id="task-description" class="text ui-widget-content ui-corner-all" style="width: 100%; margin-bottom: 10px; margin-top: 9px;"><br />
            <label for="Attribute">Attributes</label><br />
            <input id="mySingleFieldAttributes" type="hidden">
            <ul id="AttributesFields"></ul>
            <br />
            <label for="Importance">Importance</label><br />
            <select id='ImportanceDropDow' class='form-control input-sm select' style="width: 100%; margin-bottom: 10px; margin-top: 9px;">
                <option value="1">Little</option>
                <option value="2" selected>Medium</option>
                <option value="3">Very</option>
            </select><br />
            <label for="Difficulty">Difficulty</label><br />
            <select id='DifficultyDropDow' class='form-control input-sm select' style="width: 100%; margin-bottom: 10px; margin-top: 9px;">
                <option value="1">Easy</option>
                <option value="2" selected>Medium</option>
                <option value="3">Hard</option>
            </select><br />
            <label for="Difficulty">Is Repeatable</label><br />
            <input type="checkbox" id="isRepetable" />
            <br />

            <!-- Allow form submission with keyboard without duplicating the dialog button -->
            <input type="submit" tabindex="-1" style="position: absolute; top: -1000px">
        </fieldset>
    </form>
</div>

<div id="dialog-form-addToWeek" title="Schedule Task To Week Day" style="display: none">
    <form>
        <fieldset>
            <label for="name">Task</label><br />
            <input type="text" readonly name="name" id="dialog_taskDescription" class="text ui-widget-content ui-corner-all" style="width: 100%; margin-bottom: 10px; margin-top: 9px;"><br />
            <label for="category">Category</label><br />
            <input type="text" readonly name="category" id="dialog_taskCategory" class="text ui-widget-content ui-corner-all" style="width: 100%; margin-bottom: 10px; margin-top: 9px;"><br />
            <label for="dayToSchedule">Day to Schedule</label><br />
            <input type="text" name="dayToSchedule" id="dayToSchedule" class="text ui-widget-content ui-corner-all" style="width: 100%; margin-bottom: 10px; margin-top: 9px;"><br />
            <label for="beginHour">Begin Hour</label><br />
            <input type="text" class="timepicker" id="beginHour" class="text ui-widget-content ui-corner-all" style="width: 100%; margin-bottom: 10px; margin-top: 9px;" /><br />
            @*<input type="text" name="beginHour" id="beginHour" class="text ui-widget-content ui-corner-all" style="width: 100%; margin-bottom: 10px; margin-top: 9px;"><br />*@
            <label for="endHour">End Hour</label><br />
            <input type="text" name="endHour" id="endHour" class="text ui-widget-content ui-corner-all" style="width: 100%; margin-bottom: 10px; margin-top: 9px;"><br />
            <!-- Allow form submission with keyboard without duplicating the dialog button -->
            <input type="submit" tabindex="-1" style="position: absolute; top: -1000px">
        </fieldset>
    </form>
</div>

<div id="dialog-confirm" title="Delete Task and all it´s Sub-tasks?" style="display: none">
    <p><span class="ui-icon ui-icon-alert" style="float: left; margin: 0 7px 20px 0;"></span>These items will be permanently deleted and cannot be recovered. Are you sure?</p>
</div>

