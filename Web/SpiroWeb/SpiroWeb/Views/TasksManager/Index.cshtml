
@{
    ViewBag.Title = "My Task Manager";
    Layout = "~/Views/Shared/_LayoutTasks.cshtml";
}

<input type="hidden" id="IntellegencePointsPercentage" value="@ViewBag.IntellegencePointsPercentage" />
<input type="hidden" id="PerseverancePointsPercentage" value="@ViewBag.PerseverancePointsPercentage" />
<input type="hidden" id="StrengthPointsPercentage" value="@ViewBag.StrengthPointsPercentage" />
<input type="hidden" id="VitalityPointsPercentage" value="@ViewBag.VitalityPointsPercentage" />
<input type="hidden" id="CreativityPointsPercentage" value="@ViewBag.CreativityPointsPercentage" />
<input type="hidden" id="CharismaPointsPercentage" value="@ViewBag.CharismaPointsPercentage" />

<div id="PlayerStatusDiv">
    <a href="/HistoryTasks/Index">History</a>
    <a href="/Account/Logout">Logout</a>
    <div style="width: 50%; float: left; margin-top: 30px; text-align: center">
        <strong>Level:</strong> <span id="CurrentLevel">@ViewBag.Level</span><br />
        <strong>Points:</strong> <span id="CurrentPoints">@ViewBag.Points</span>
    </div>
    <div style="width: 50%; overflow: hidden;">
        <table>
            <tr>
                <td style="width: 120px;"><strong style="float: left">Intelligence</strong></td>
                <td style="width: 50px; text-align: center;"><span id="CurrentIntellegencePoints" style="float: left">@ViewBag.Intellegence</span></td>
                <td style="width: 100px">
                    <div id="progressBar_Intellegence" class="tiny-green">
                        <div></div>
                    </div>
                </td>
                <td style="padding-left:5px">@(ViewBag.IntellegencePointsPlus)x </td>
            </tr>
            <tr>
                <td><strong style="float: left">Perseverance</strong> </td>
                <td><span id="CurrentPerseverancePoints" style="float: left">@ViewBag.Perseverance</span></td>
                <td>
                    <div id="progressBar_Perseverance" class="tiny-green">
                        <div></div>
                    </div>
                </td>
                <td style="padding-left:5px">@(ViewBag.PerseverancePointsPlus)x</td>
            </tr>
            <tr>
                <td><strong style="float: left">Strength</strong></td>
                <td><span id="CurrentStrengthPoints" style="float: left">@ViewBag.Strength</span></td>
                <td>
                    <div id="progressBar_Strenght" class="tiny-green">
                        <div></div>
                    </div>
                </td>
                <td style="padding-left:5px">@(ViewBag.StrengthPointsPlus)x</td>
            </tr>
            <tr>
                <td><strong style="float: left">Vitality</strong></td>
                <td><span id="CurrentVitalityPoints" style="float: left">@ViewBag.Vitality</span></td>
                <td>
                    <div id="progressBar_Vitality" class="tiny-green">
                        <div></div>
                    </div>
                </td>
                <td style="padding-left:5px">@(ViewBag.VitalityPointsPlus)x</td>
            </tr>
            <tr>
                <td><strong style="float: left">Creativity</strong></td>
                <td><span id="CurrentCreativityPoints" style="float: left">@ViewBag.Creativity</span></td>
                <td>
                    @*<div style="width: 100px; float: left; margin-top: 5px; margin-left: 20px">*@
                    <div id="progressBar_Creativity" class="tiny-green">
                        <div></div>
                    </div>
                    @*</div>*@
                </td>
                <td style="padding-left:5px">@(ViewBag.CreativityPointsPlus)x</td>
            </tr>
            <tr>
                <td><strong style="float: left">Charisma</strong> </td>
                <td><span id="CurrentCharismaPoints" style="float: left">@ViewBag.Charisma</span></td>
                <td>
                    <div id="progressBar_Charisma" class="tiny-green">
                        <div></div>
                    </div>
                </td>
                <td style="padding-left:5px">@(ViewBag.CharismaPointsPlus)x</td>
            </tr>
        </table>
    </div>
    <div>
        <input id="showHideTasks" onchange="showHideTasks()" type="checkbox" /><label>Hide Done Tasks</label>
    </div>
</div>
<div id="accordion" style="margin-top:50px">
    <h3>Weekly Calendar Tasks</h3>
    <iframe id="WeekCalenderIframe" src="~/weekcalendar/weekcalendar.html" width="100%" height="1000px"></iframe>
    @*<div id='calendar'></div>*@

</div>

