@model ClassLibrary1.Products

@{
    ViewBag.Title = "Delete";
}

<h2>Delete</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Product</h4>
    <hr />
    <dl class="dl-horizontal">
        <dd>
            @{
                var imgSrc = string.Empty;
                if (Model.Picture != null)
                {
                    var base64 = Convert.ToBase64String(Model.Picture);
                    imgSrc = String.Format("data:image/gif;base64,{0}", base64);
                }
            }
            <img src="@imgSrc" style="float:left" />
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Barcode)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Barcode)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Name)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Brand)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Brand)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Price)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.Price)
        </dd>

        <dt>
            Weight / Price
        </dt>

        <dd>
            @Html.DisplayFor(model => model.VariableWeightPrice)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.CategoryString)
        </dt>

        <dd>
            @Html.DisplayFor(model => model.CategoryString)
        </dd>

        <dt>
            @Html.DisplayNameFor(model => model.Picture)
        </dt>

        <dt>
            Create Date
        </dt>

        <dd>
            @Html.DisplayFor(model => model.InsertDate)
        </dd>

    </dl>

    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()

        <div class="form-actions no-color">
            <input type="submit" value="Delete" class="button-primary"/>   
            @Html.ActionLink("Back to List", "Index", null, new { @class = "button - primary" })
        </div>
    }

    @*@using (Html.BeginForm("DeleteAll", "Products"))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" id="id" name="id" value='@Model.Id' />
        <div class="row">
            <input type="submit" value="Delete Product and Associations" class="btn btn-default" />
        </div>
    }*@
</div>
