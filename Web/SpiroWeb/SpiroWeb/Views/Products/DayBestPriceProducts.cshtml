@model List<KeyValuePair<int, double>>

@{
    ViewBag.Title = "Day Best Price Products";
}

@*<div style="padding:25px;display: inline-block;">
        <h3 style="float:left">Updates count:</h3>
        <h3 id="newProducPricesUpdates" style="float:left;padding-left:5px"></h3>
        <h3 style="float:left;padding-left:40px">Started at:</h3>
        <h3 style="color:green;float:left;padding-left:5px">@DateTime.Now.ToString()</h3>
    </div>*@
<br><br><br>
        <table id="DayBestPrieProducts" class="table table-responsive">
            <tr>
                <th style="text-align: center;">
                    Image
                </th>
                <th style="text-align: center;">
                    ProductId
                </th>
                <th style="text-align: center;">
                    Savings
                </th>
                <th style="text-align: center;">
                    Share Link
                </th>
                <th></th>
            </tr>

            @foreach (var item in Model)
            {
                var _productId = item.Key;
                var _savings = item.Value;
                if (_savings > 19)
                {
                    <tr>
                        <td style="text-align: center; vertical-align: middle;">
                            <a href="@Url.Action("Details", "Products", new { id = _productId })"><img style="width:140px" src="~/Handlers/GetProductImage.ashx?productId=@_productId" /></a>
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <a href="@Url.Action("Details", "Products", new { id = _productId })">@_productId</a>
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            @_savings%
                        </td>
                        <td style="text-align: center; vertical-align: middle;">
                            <a href="https://lisie.app/s/p?id=@_productId" target="_blank">https://lisie.app/s/p?id=@_productId</a>
                        </td>
                    </tr>
                }


            }

        </table>
@section scripts {
    <script src="~/Scripts/jquery.color-2.1.2.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.2.0.js"></script>
    <script src="../signalr/hubs"></script>
    <script src="~/SignalR.Sample/SignalR.Interactions.js"></script>
}