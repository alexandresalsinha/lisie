<br><br><br>
<table id="ProductPricesUpdatesTable" class="table table-responsive">
    <tr>
        <th style="text-align: center;">
            Id
        </th>
        <th style="text-align: center;">
            UserId
        </th>
        <th style="text-align: center;">
            ProductId
        </th>
        <th style="text-align: center;">
            Info
        </th>
        <th style="text-align: center;">
            Create Date
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {

    <tr>
        <td style="text-align: center; vertical-align: middle;">
            @item.Id
        </td>
        <td style="text-align: center; vertical-align: middle;">
            @item.UserId
        </td>
        <td>
            <a href="@Url.Action("Details", "Products", new { id = item.ProductId })">@item.ProductId</a>
        </td>
        <td style="text-align: center; vertical-align: middle;">
            @item.Info
        </td>
        <td style="text-align: center; vertical-align: middle;">
            @*@item.CreateDate.ToString("dd-MM-yyyy hh:mm")*@
        </td>
    </tr>

    }

</table>
@section scripts {
    <script src="~/Scripts/jquery.color-2.1.2.min.js"></script>
    <script src="~/Scripts/jquery.signalR-2.2.0.js"></script>
    <script src="../signalr/hubs"></script>
    <script src="~/SignalR.Sample/SignalR.Interactions.js"></script>
}