            @*<img src="@imgSrc" />*@
        </dd>

        <dt>
            Código de barras
        </dt>

        <dd>
            @Html.DisplayFor(model => Model.Product.Barcode)
        </dd>

        <dt>
            Nome
        </dt>

        <dd>
            @Html.DisplayFor(model => Model.Product.Name)
        </dd>
        <dt>
            Marca
        </dt>

        <dd>
            @Html.DisplayFor(model => Model.Product.Brand)
        </dd>
        <dt>
            Peso
            @*@Html.DisplayNameFor(model => Model.Product.VariableWeightPrice)*@
        </dt>

        <dd>
            @Html.DisplayFor(model => Model.Product.Weight)
        </dd>

        <dt>
            Peso / Preço
            @*@Html.DisplayNameFor(model => Model.Product.VariableWeightPrice)*@
        </dt>

        <dd>
            @Html.DisplayFor(model => Model.Product.VariableWeightPrice)
        </dd>



        <dt>
            @*@Html.DisplayNameFor(model => Model.Product.CategoryString)*@
