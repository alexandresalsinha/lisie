@model IEnumerable<SpiroWeb.Objects.ProductSearchResult>

@{
    ViewBag.Title = "Index";

    int _productCounter = 1;

    //IEnumerable<SpiroWeb.Objects.ProductSearchResult> _jumboResults = Model.ToList();
    IEnumerable<SpiroWeb.Objects.ProductSearchResult> _jumboResults = Model.Where(c => c.Store.ToLower().Equals("jumbo")).ToList();
    IEnumerable<SpiroWeb.Objects.ProductSearchResult> _continenteResults = Model.Where(c => c.Store.ToLower().Equals("continente")).ToList();

}



<div style="margin-top: 15px;margin-bottom: 15px;">
    <input id="productQueueSearchTextAgain" type="text" style="width: 100%;" />
    <div style="width:100%; text-align:center; margin-top:10px">
        <button id="productQueueSearchButton" class="ladda-button" data-style="expand-right" onclick="GetProductsQueueSearchResultsAgain()">
            <span class="ladda-label">Search Again</span>
            <span class="ladda-spinner"></span>
        </button>
    </div>
</div>

<div class="tab">
    <button id="jumboButton" class="tablinks active" onclick="openCity(event, 'Jumbo')">Jumbo(@_jumboResults.Count())</button>
    <button class="tablinks" onclick="openCity(event, 'Continente')">Continente(@_continenteResults.Count())</button>
</div>

<div id="Jumbo" class="tabcontent" style="display:block">
    @if (_jumboResults.Count() > 0)
    {
        <h2 style="text-align: center;margin-bottom: 30px;">Search Results from Jumbo</h2>

            <table class="u-full-width" style="text-align:center; width:100%">
                <thead>
                    @foreach (var item in _jumboResults)
                    {
                        <tr>
                            <td>
                                <img style="width:140px" src="@item.ImageUrl" />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p>@item.Name</p>
                                <p>@item.Brand</p>
                                <p>@item.Weight</p>
                                <p><b>@item.Price</b></p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <button id="Button_selectProductOnline-@_productCounter" class="ladda-button" style="margin-bottom: 30px;" data-color="green" data-style="expand-right" onclick="GetSelectedProductData('@item.Url', 'jumbo', 'Button_selectProductOnline-@_productCounter')">
                                    <span class="ladda-label">This is the one!</span>
                                    <span class="ladda-spinner"></span>
                                </button>
                            </td>
                        </tr>
                        _productCounter++;
                    }
            </table>
    }
</div>

<div id="Continente" class="tabcontent">
    <h3>Continente</h3>
    @if (_continenteResults.Count() > 0)
    {
        //_productCounter = 1;

        <h2 style="text-align: center;margin-bottom: 30px;">Search Results from Continente</h2>

            <table class="u-full-width" style="text-align:center; width:100%">
                <thead>
                    @foreach (var item in _continenteResults)
                    {
                        <tr>
                            <td>
                                <img style="width:140px" src="@item.ImageUrl" />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <p>@item.Name</p>
                                <p>@item.Brand</p>
                                <p>@item.Weight</p>
                                <p><b>@item.Price</b></p>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <button id="Button_selectProductOnline-@_productCounter" class="ladda-button" style="margin-bottom: 30px;" data-color="green" data-style="expand-right" onclick="GetSelectedProductData('@item.Url', 'continente' , 'Button_selectProductOnline-@_productCounter')">
                                    <span class="ladda-label">This is the one!</span>
                                    <span class="ladda-spinner"></span>
                                </button>
                            </td>
                        </tr>
                        _productCounter++;
                    }
            </table>
    }
</div>


