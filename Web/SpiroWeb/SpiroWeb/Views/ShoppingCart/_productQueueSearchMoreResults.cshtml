@model IEnumerable<SpiroWeb.Objects.ProductSearchResult>

@{ 
    int _productCounter = 1;
}
<table class="table">
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img style="width:140px" src="@item.ImageUrl" />
            </td>
        </tr>
        <tr>
            <td>
                <p>@item.Name</p>
                <p>@item.Brand</p>
                <p>@item.Weight</p>
                <p><b>@item.Price</b></p>
            </td>
        </tr>
        <tr>
            <td>
                <div style="width:100%; text-align:center">
                    <button id="Button_selectProductOnline-@_productCounter" class="ladda-button" data-style="expand-right" onclick="GetSelectedProductData('@item.Url')">
                        <span class="ladda-label">This is the one</span>
                        <span class="ladda-spinner"></span>
                    </button>
                </div>
            </td>
        </tr>
        _productCounter++;
    }
</table>
<input type="button" onclick="GetProductsQueueSearchMoreResults()" value="Load More Results" />
