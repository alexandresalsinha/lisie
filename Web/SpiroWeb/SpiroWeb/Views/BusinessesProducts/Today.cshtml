@{
    ViewBag.Title = "Index";
}
@using PagedList.Mvc;
@using PagedList;

<br>
<br>
<span><b> Data de inicio: </b><input type="text" id="datepicker_start"></span>
<span style="margin-left:20px"> <b> Data de fim:</b> <input type="text" id="datepicker_end"></span>
<span><button onclick="getWithDates()">Procurar</button></span>

<div style="width:100%; text-align:left; margin-top:20px">
    <label for="categories">Categoria:</label>

    <select name="categories" id="categories" onchange="onCategoryChange()">
        @foreach (var item in (IEnumerable<SelectListItem>)ViewBag.Categories)
        {

            <option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Value</option>
        }
    </select>
    @*@Html.DropDownList("Categories", (IEnumerable
        <SelectListItem>)ViewBag.Categories)*@
</div>
<div style="width:100%; text-align:center; margin-top:50px">
    <span> @ViewBag.StartDate</span>
    <span> - @ViewBag.EndDate</span>
</div>


<div style="width:100%; text-align:center; margin-top:20px">
    <span>Total</span>
    <br />
    <span>@ViewBag.Total €</span>
</div>
<br />
<br />

<table class="table table-responsive">
    <tr>
        <th style="text-align: center;">
            Nome
        </th>

        <th style="text-align: center;">
            Quantidade
        </th>
        <th style="text-align: center;">
            Preço
        </th>
    </tr>

    @foreach (var item in ViewBag.Items)
    {
        double _priceTotal = (item.Price * item.Quantity);
        var _priceText = _priceTotal.ToString();
        var _price = SpiroWeb.Helpers.TextTools.ParsePrice(_priceText);

        <tr>

            <!--<td>
            <a href="@Url.Action("Details", "Products", new { id = item.Id })"><img style="width:140px" src="~/Handlers/GetProductImage.ashx?productId=@item.ProductId" /></a>-->
            @*<img style="width:140px" src="@item.ImageUrl" />*@
            <!--</td>-->
            <td style="text-align: center; vertical-align: middle;">
                @item.Name
            </td>

            <td style="text-align: center; vertical-align: middle;">
                @item.Quantity
            </td>
            <td style="text-align: center; vertical-align: middle;">
                @_price €
            </td>
        </tr>
    }
</table>
<script>
    var _startDate;
    var _endDate;
    $(function () {
        $("#datepicker_start").datepicker({
            //dateFormat: "m/d/yy",
            onSelect: function () {
                _startDate = this.value;
            }
        });
        $("#datepicker_end").datepicker({
            //dateFormat: "m/d/yy",
            onSelect: function () {
                _endDate = this.value;
            }
        });

        //$("#datepicker_start").datepicker("option",
        //    $.datepicker.regional["pt"]);
        debugger
        const queryString = window.location.search;
        const urlParams = new URLSearchParams(queryString);
        const _dateStart = urlParams.get('dateStart')
        const _dateEnd = urlParams.get('dateEnd');

        if (_dateStart && _dateEnd) {
            $("#datepicker_start").datepicker('setDate', new Date(_dateStart));
            $("#datepicker_end").datepicker('setDate', new Date(_dateEnd));
            _startDate = _dateStart;
            _endDate = _dateEnd;
        }
    });

    function getWithDates() {
        const queryString = window.location.search;
        const urlParams = new URLSearchParams(queryString);
        const _businessId = urlParams.get('b');
        var _selectedCategory = document.getElementById("categories").value;
        window.open('?b=' + _businessId + '&dateStart=' + encodeURIComponent(_startDate) + '&dateEnd=' + encodeURIComponent(_endDate) + '&category=' + encodeURIComponent(_selectedCategory), "_self");
    }

    function onCategoryChange(event) {
        const queryString = window.location.search;
        const urlParams = new URLSearchParams(queryString);
        const _businessId = urlParams.get('b');
        const _dateStart = urlParams.get('dateStart')
        const _dateEnd = urlParams.get('dateEnd');

        var _selectedCategory = document.getElementById("categories").value;
        if (_dateStart && _dateEnd) {
            window.open('?b=' + _businessId + '&dateStart=' + encodeURIComponent(_startDate) + '&dateEnd=' + encodeURIComponent(_endDate) + '&category=' + encodeURIComponent(_selectedCategory), "_self");

        } else {
            window.open('?b=' + _businessId + '&category=' + encodeURIComponent(_selectedCategory), "_self");
        }
    }
</script>
@section scripts {
    <script src="~/Scripts/datepicker-pt.js"></script>
}
